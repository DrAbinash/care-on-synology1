{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "push-ci": "tsx scripts/db-deploy.ts",
    "deploy": "tsx scripts/db-deploy.ts",
    "manage": "tsx scripts/db-manage.ts",
    "db:manage": "tsx scripts/db-manage.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.9",
    "tsx": "catalog:"
  }
}
