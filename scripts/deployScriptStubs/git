#!/bin/bash
# Stub `git` for the deploy.sh harness. Reads its world from $STATE, logs calls
# to $CALLS. Never touches a real repository.
log() { printf 'git %s\n' "$*" >> "$CALLS"; }
log "$*"
case "$1" in
  rev-parse)
    shift
    case "$1" in
      --abbrev-ref) echo main ;;
      --short)
        cur="$(cat "$STATE/head")"
        if [ "${2:-}" = "HEAD" ] || [ -z "${2:-}" ]; then printf '%s\n' "${cur:0:7}"
        else printf '%s\n' "${2:0:7}"; fi ;;
      *) printf '%s\n' "$(cat "$STATE/head")" ;;
    esac
    ;;
  status)
    [ -f "$STATE/dirty" ] && cat "$STATE/dirty"
    ;;
  fetch) : ;;
  merge)
    if [ -f "$STATE/merge.rc" ] && [ "$(cat "$STATE/merge.rc")" != 0 ]; then
      echo "fatal: Not possible to fast-forward, aborting." >&2
      exit "$(cat "$STATE/merge.rc")"
    fi
    printf '%s\n' "$(cat "$STATE/head-after")" > "$STATE/head"
    # STUB_SELF_MODIFY names a COPY of the script that is executing right now,
    # and this simulates the fast-forward rewriting that very file while bash is
    # still reading it — the hazard deploy.sh's self_fingerprint exists for. The
    # rewrite is capped at STUB_SELF_MODIFY_LIMIT (default 1) so one scenario can
    # also prove the run stops after a single re-exec instead of looping; with no
    # limit the guard-less script would exec forever and only the kill timer
    # would notice, which is a slow test and a vague one.
    if [ -n "${STUB_SELF_MODIFY:-}" ] && [ -f "$STUB_SELF_MODIFY" ]; then
      n=0; [ -f "$STATE/self-modify" ] && n="$(cat "$STATE/self-modify")"
      if [ "$n" -lt "${STUB_SELF_MODIFY_LIMIT:-1}" ]; then
        printf '\n# appended by the stub fast-forward, simulating a moved checkout\n' >> "$STUB_SELF_MODIFY"
        printf '%s\n' "$((n + 1))" > "$STATE/self-modify"
      fi
    fi
    ;;
  log)   printf '%s\n' "$(cat "$STATE/subject")" ;;
  rev-list) echo 3 ;;
  diff)   echo "a.ts"; echo "b.ts" ;;
  *) exit 0 ;;
esac
exit 0
