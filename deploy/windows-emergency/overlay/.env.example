# Copy to .env on the DS225+ and fill in secrets. Never commit the real .env.
# Suggested path: /volume1/docker/care-emergency/.env

# Dedicated Emergency Billing database (NOT diagnostic_erp / care-db)
EMERGENCY_DB_USER=emergency
EMERGENCY_DB_PASSWORD=change-me-to-a-long-random-string
EMERGENCY_DB_NAME=care_emergency

# Bind Postgres to loopback on the NAS. Do not publish 0.0.0.0.
EMERGENCY_DB_BIND=127.0.0.1
EMERGENCY_DB_HOST_PORT=5410

# Browser access for reception PCs (emergency LAN)
EMERGENCY_HTTP_BIND=0.0.0.0
EMERGENCY_HTTP_PORT=80

# Shared secret CARE uses to fetch pending bills / push master data.
# Generate: openssl rand -hex 32
# Must match CARE Settings → Billing → Emergency Billing fetch token.
EMERGENCY_FETCH_TOKEN=

# Main CARE base URL for Windows Emergency PC pull/push (LAN IP preferred).
# Leave blank on DS225+ if CARE always pushes/fetches toward this NAS.
# PRIMARY_CARE_URL=http://192.168.1.50:8080
# EMERGENCY_DEVICE_ID=ds225-emergency
# MASTER_PULL_INTERVAL_HOURS=6
# CARE_OFFLINE_GRACE_MS=90000

# Optional first-boot owner if CARE has not yet pushed staff identities.
# Leave blank after the first successful master-data sync.
EMERGENCY_BOOTSTRAP_USERNAME=
EMERGENCY_BOOTSTRAP_PIN=

SESSION_HOURS=8

# Optional build identity shown on CARE's compatibility card (no secrets).
# APP_VERSION=1.0.0
# GIT_COMMIT=

# Logical dump directory. On DS225+ prefer:
# EMERGENCY_BACKUP_DIR=/volume1/docker/care-emergency/backups
# Leave unset to use the dedicated Docker volume care_emergency_backups.
# Never point this at a Hyper Backup vault or DS1522+ backup share.
# EMERGENCY_BACKUP_DIR=/volume1/docker/care-emergency/backups
