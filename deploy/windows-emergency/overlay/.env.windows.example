# Windows Emergency CARE PC — copy to .env and edit.
# Do NOT use Synology /volume1 paths on Windows.

EMERGENCY_DB_USER=emergency
EMERGENCY_DB_PASSWORD=change-me-to-a-long-random-string
EMERGENCY_DB_NAME=care_emergency

# Loopback-only Postgres on the Windows PC
EMERGENCY_DB_BIND=127.0.0.1
EMERGENCY_DB_HOST_PORT=5410

# Browser access for clinic LAN PCs (Docker Desktop publishes this port)
EMERGENCY_HTTP_BIND=0.0.0.0
EMERGENCY_HTTP_PORT=8080

# Shared secret — must match Main CARE Settings → Billing → Emergency Billing fetch token
# PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
EMERGENCY_FETCH_TOKEN=

# Main CARE ERP base URL (LAN IP preferred — do not rely on Synology QuickConnect)
# Example: http://192.168.1.50:8080   or   http://192.168.1.50
PRIMARY_CARE_URL=http://192.168.1.50:8080

# Stable ID for this Windows emergency PC (stored on each emergency bill)
EMERGENCY_DEVICE_ID=windows-emergency-pc-1

# Optional first-boot owner if CARE has not yet pushed/pulled staff
EMERGENCY_BOOTSTRAP_USERNAME=owner
EMERGENCY_BOOTSTRAP_PIN=1234

SESSION_HOURS=8

# Auto master-data pull from Main CARE when reachable (hours). 0 = disable auto pull.
MASTER_PULL_INTERVAL_HOURS=6

# Grace before declaring Main CARE OFFLINE (milliseconds)
CARE_OFFLINE_GRACE_MS=90000

# Optional host folder for SQL dumps (Docker Desktop shared drive). Leave unset for named volume.
# EMERGENCY_BACKUP_DIR=C:/care-emergency/backups
