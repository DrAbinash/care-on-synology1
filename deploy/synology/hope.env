# =============================================================================
# Hope NeuroTrauma Hospital ERP — Synology NAS .env
# Copy to the folder beside docker-compose.yml:
#   cp deploy/synology/hope.env .env
# Then: docker compose up -d --build
# URL: http://192.168.1.137:7080/
# =============================================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
APP_PORT=7080
SERVE_STATIC_DIR=/app/artifacts/hms/dist/public

SESSION_SECRET=8a93b36b38b4c42f63ce6f728f840fdb829d3f8a4dfed6057456a0273072c739f1c15db8c0c6a79ec45643c622b44810
INSECURE_COOKIES=1
INITIAL_ADMIN_PIN=123456

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/hospital_erp
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hospital_erp

UPLOADS_DIR=/app/uploads
REPORTS_DIR=/app/reports
STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=/app/uploads

ALLOWED_ORIGINS=
LOG_LEVEL=info

TZ=Asia/Kolkata
BACKUP_PATH=./backups
BACKUP_HOUR=2
BACKUP_MINUTE=30
BACKUP_RETENTION_DAYS=30
BACKUP_VERIFY_DOW=0

# -----------------------------------------------------------------------------
# CARE Diagnostics integration (Hope Hospital ↔ Care ERP on same NAS)
# Care public: https://caredeoghar.com  LAN: http://192.168.1.137:8888
# Keys must match Care deploy/synology/care.env (HOPE_PARTNER_KEY /
# INTEGRATION_HOPE_SIGNING_SECRET). Care auto-registers the partner on API start.
# -----------------------------------------------------------------------------
ENABLE_CARE_INTEGRATION=1
CARE_REFERRAL_URL=http://192.168.1.137:8888/api/integration/v1
# If LAN URL fails from inside Docker, use public URL instead:
# CARE_REFERRAL_URL=https://caredeoghar.com/api/integration/v1
CARE_PARTNER_KEY=intgk_8ffb1b9c5b982148cfbe89448064cc4986b172bea48fe73b0f622f4a192da7e7
CARE_CALLBACK_SECRET=7ab91cf3b7a45c4a3b4a6a90aa63ed2be921abc77bbd007f0de60093ba895f0f
CARE_BOOKING_URL=https://caredeoghar.com/book
NOTIFY_PROVIDER=care
NOTIFY_DEFAULT_COUNTRY_CODE=+91

