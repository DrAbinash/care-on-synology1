# =============================================================================
# PACS / Orthanc (care-pacs compose on same NAS)
# =============================================================================
ORTHANC_URL=http://192.168.1.137:8042
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=
PACS_PROVIDER=orthanc
PACS_VIEWER_TYPE=ohif
OHIF_URL=http://192.168.1.137:3010
WADO_URL=http://192.168.1.137:8042/wado
