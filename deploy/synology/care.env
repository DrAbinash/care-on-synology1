# =============================================================================
# Care Diagnostics ERP — Synology NAS .env
# TEMPLATE — no secret values. Copy beside docker-compose.yml (`cp deploy/synology/care.env .env`,
# deploy-synology.sh does it if missing), then fill every REPLACE_ME_*. A real value here is published.
# Then: docker compose up -d --build
# Public: https://caredeoghar.com   LAN: http://172.16.1.139:8888
#
# Hope↔Care partner + ff_hope_care_referrals auto-provision on every API start
# when the Hope block below is present — no manual bootstrap.
# Rewritten 2026-07-31 — live secrets kept; MWL + Hope blocks complete.
# =============================================================================

# --- Web ---------------------------------------------------------------------
HOST_PORT=8888
PUBLIC_BASE_URL=https://caredeoghar.com
NETWORK_LAN_HOST=172.16.1.139
# Optional second NAS LAN IP (some clinic VLANs route only to this address):
# NETWORK_LAN_HOST_ALT=192.168.1.137
# VITE_NETWORK_LAN_HOST_ALT=192.168.1.137
ERP_HTTP_PORT=8888
TZ=Asia/Kolkata
LOG_LEVEL=info
OBJECT_STORAGE_DIR=/app/data/object-storage

# --- PostgreSQL (host 5400 → container 5432) ---------------------------------
DB_HOST_PORT=5400
DB_USER=erp
# ⚠️ STAGED: still "changeme" on the live volume. Do NOT change alone —
# ALTER USER erp first, then this line, then recreate api/db-patch.
DB_PASSWORD=REPLACE_ME_db_password
DB_NAME=diagnostic_erp

# --- App secrets -------------------------------------------------------------
JWT_SECRET=REPLACE_ME_jwt_secret
SESSION_SECRET=REPLACE_ME_session_secret
# Pin OLD session secret so existing NAS backups stay decryptable.
BACKUP_PASSPHRASE=REPLACE_ME_backup_passphrase

# --- Schedulers / cron -------------------------------------------------------
ENABLE_SCHEDULERS=1
CRON_SECRET=REPLACE_ME_cron_secret
BACKUP_DEADMAN_MAX_AGE_HOURS=26

# --- Super Admin USB ---------------------------------------------------------
SUPER_ADMIN_USB_KEY=REPLACE_ME_super_admin_usb_key
SUPER_ADMIN_USB_PIN=REPLACE_ME_super_admin_usb_pin

# --- ICICI Orange Pay --------------------------------------------------------
ICICI_BASE_URL=https://pgpay.icicibank.com
ICICI_URL_PREFIX=
ICICI_MERCHANT_ID=100000000455452
ICICI_AGGREGATOR_ID=100000000455451
ICICI_SECRET_KEY=REPLACE_ME_icici_secret_key

FINGERPRINT_BRIDGE_SECRET=

# =============================================================================
# PACS / Orthanc (care-pacs compose on same NAS)
# =============================================================================
ORTHANC_URL=http://172.16.1.139:8042
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=
PACS_PROVIDER=orthanc
PACS_VIEWER_TYPE=ohif
# Browser-facing OHIF (HTTPS RP). Load Clinic Viewer Defaults uses this.
OHIF_PUBLIC_BASE_URL=https://ohif.caredeoghar.com
# Legacy LAN port — do not use for ohif_base_url; kept for ops/reference only.
OHIF_URL=http://172.16.1.139:3010
WADO_URL=http://172.16.1.139:8042/wado
WEASIS_WADO_PUBLIC_URL=http://172.16.1.139:8042/wado

# care-erp-sync owns Orthanc→ERP — keep in-process poller OFF
ORTHANC_CHANGES_POLLER=false

# Must match care_erp_sync.py ERP_INTERNAL_API_KEY (rotate both together).
INTERNAL_API_KEY=REPLACE_ME_internal_api_key
ALLOW_PRIVATE_IPS=true

# --- Antigravity MWL (ERP → modality names + accession / work id) ------------
# mkdir -p /volume1/docker/care-pacs/orthanc/worklists
# Mounted into care-api as /orthanc-worklists and into Orthanc worklists plugin.
ORTHANC_WORKLIST_DIR=/orthanc-worklists
ORTHANC_WORKLIST_HOST_DIR=/volume1/docker/care-pacs/orthanc/worklists
# Staging = <ORTHANC_WORKLIST_DIR>/staging on the same bind mount (atomic rename).
# Do not set a separate staging volume — that caused production EXDEV.

# =============================================================================
# Local AI / OCR (Windows PC)
# =============================================================================
OLLAMA_PRIMARY_URL=http://192.168.1.250:11434
# Only one AI PC is currently reachable; the secondary address it used here no longer
# answers, so failover pointed at a dead host and added a timeout to every attempt.
OLLAMA_FALLBACK_URL=http://192.168.1.250:11434
OLLAMA_BASE_URL=http://192.168.1.250:11434
OLLAMA_DEFAULT_MODEL=gemma3:4b

OCR_ENGINE=paddle
OCR_PROFILE=fast
OCR_DEVICE=cpu
OCR_LOW_CONFIDENCE_THRESHOLD=0.80
OCR_RETRY_ACCURATE=true
OCR_TESSERACT_FALLBACK=true
OCR_WORKER_URL=http://192.168.1.250:8090
OCR_WORKER_CONCURRENCY=1
OCR_WORKER_TOKEN=REPLACE_ME_ocr_worker_token

AI_MODE=AUTO
AI_MODEL_FAST=gemma3:4b
AI_MODEL_STANDARD=gemma3:4b
AI_MODEL_LARGE=gemma3:12b
AI_MODEL_VISION=qwen3-vl:8b
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=0
AI_TIMEOUT_FAST_SECONDS=120
AI_TIMEOUT_LARGE_SECONDS=300
AI_CONCURRENCY=1
AI_TEMPERATURE_EXTRACTION=0
AI_TEMPERATURE_DRAFT=0.1

# =============================================================================
# Hope Hospital (Hope @ :7080) — keys MUST match Hope .env
# care-api registers the HOPE partner + ff_hope_care_referrals when
# HOPE_PARTNER_KEY is set; with it empty the integration stays unregistered.
# Finance stays separate (Hope Hospital / Hope Medicals / Care).
#
# THE TWO KEYS ARE DELIBERATELY EMPTY. Real values go in .env on the NAS only,
# never back into this tracked template. One line each on the NAS:
#   INTEGRATION_HOPE_SIGNING_SECRET=$(openssl rand -hex 32)   → = Hope CARE_CALLBACK_SECRET
#   HOPE_PARTNER_KEY=intgk_$(openssl rand -hex 32)            → = Hope CARE_PARTNER_KEY
# Rotation procedure: docs/hope-care-integration/06_CREDENTIAL_ROTATION.md
# =============================================================================
INTEGRATION_HOPE_CALLBACK_URL=http://172.16.1.139:7080/api/integration/care-callback
INTEGRATION_HOPE_SIGNING_SECRET=
HOPE_CARE_INTEGRATION_FORCE=1
HOPE_PARTNER_KEY=
