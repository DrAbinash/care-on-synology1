{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/preinstall-check.cjs",
    "build": "pnpm run check:grounding && pnpm run typecheck && pnpm -r --if-present run build",
    "check:grounding": "node scripts/grounding-check.cjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "concurrently -n api,erp,admin -c blue,green,magenta \"pnpm --filter @workspace/api-server run dev\" \"pnpm --filter @workspace/diagnostic-erp run dev\" \"pnpm --filter @workspace/super-admin-portal run dev\"",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:erp-local": "node scripts/dev-erp-local.mjs",
    "dev:restart": "node scripts/dev-restart-supervisor.mjs",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:deploy": "pnpm --filter @workspace/db run deploy",
    "db:manage": "pnpm --filter @workspace/db run manage",
    "db:check-migration-order": "node scripts/check-migration-order.cjs",
    "db:smoke": "node scripts/migration-bootstrap-smoke.mjs",
    "db:migration-manifest": "node scripts/migration-manifest.mjs",
    "api:route-coverage": "node scripts/api-route-coverage.mjs",
    "e2e:smoke": "playwright test tests/e2e/erp-smoke.spec.ts --config playwright.config.ts",
    "e2e:voice-composer": "playwright test tests/e2e/voice-composer-clinic-demo.spec.ts --config playwright.config.ts",
    "db:bootstrap": "node scripts/apply-all-migrations.mjs",
    "operations:verify-deployment": "node scripts/verify-deployment.mjs",
    "operations:verify-ollama-ai-draft": "node scripts/verify-ollama-ai-draft.mjs",
    "validate:radiology-content": "pnpm --filter @workspace/scripts run validate:radiology-content",
    "smoke:production": "pnpm --filter @workspace/api-server run smoke",
    "test": "vitest run"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "playwright": "^1.62.1"
  }
}
