+    "CLINIC_EMAIL": "",
+    "CLINIC_WEBSITE": "",
+    "CLINIC_LOGO_PATH": "",
+    "OUTPUT_DIR": "/data/print-jobs",
+    "OUTPUT_FORMAT": "pdf",
+    "JOB_RETENTION_DAYS": 30,
