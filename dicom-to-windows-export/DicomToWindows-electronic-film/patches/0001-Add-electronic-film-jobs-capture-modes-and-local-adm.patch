+SECRET_KEYS = frozenset({
+    "HTTP_BRIDGE_SECRET", "ADMIN_PASSWORD_HASH", "ADMIN_PASSWORD",
+})
+
+DEFAULTS: dict[str, Any] = {
+    "DICOM_AET": "PRINTSCP",
