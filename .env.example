# =============================================================================
# Care Diagnostics — Environmental Configuration Template
# =============================================================================
# Copy this file to ".env" in the same folder as your docker-compose.yml file.
# Replace all placeholder values with secure, strong credentials.

# --- NETWORK & PORTS ---------------------------------------------------------
# Host port nginx will listen on. Open http://localhost:<HOST_PORT> (or http://<nas-ip>:<HOST_PORT>)
HOST_PORT=8888

# --- DATABASE SETTINGS -------------------------------------------------------
# Used both by the PostgreSQL container and the API service connection string
# ⚠️ CHANGE THESE credentials before deploying. Patient data is stored here!
DB_USER=erp
DB_PASSWORD=changeme
DB_NAME=diagnostic_erp

# --- API SERVICES CONFIGURATION ---------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# JWT/Session authentication secrets (Make these long, random strings)
JWT_SECRET=change-me-to-a-long-random-secret
SESSION_SECRET=change-me-to-another-long-random-secret

# Directory inside the container where uploaded documents/reports are saved
OBJECT_STORAGE_DIR=/app/data/object-storage

# --- OPTIONAL: GEMINI AI INTEGRATION (For automated report suggestions) -----
# AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_api_key_here
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- OPTIONAL: PACS / ORTHANC INTEGRATION (For RIS-PACS/OHIF features) ------
# PACS provider: "orthanc" (recommended) or "conquest"
# PACS_PROVIDER=orthanc
#
# Care Diagnostics Orthanc (care-pacs container on Synology):
#   LAN:        http://192.168.1.137:8042
#   Docker alt: http://172.16.1.139:8042
# ORTHANC_URL=http://192.168.1.137:8042
# ORTHANC_USERNAME=admin
# ORTHANC_PASSWORD=
#
# Viewer: "ohif" (web-based, works over DICOMweb) or "weasis" (local Windows app)
# PACS_VIEWER_TYPE=ohif
# OHIF_URL=http://192.168.1.137:3000
# WADO_URL=http://192.168.1.137:8042/wado
#
# Allow API container to call LAN IPs (required for Orthanc on same LAN)
# ALLOW_PRIVATE_IPS=true

# --- OPTIONAL: FINGERPRINT SCANNER BRIDGE ------------------------------------
# FINGERPRINT_BRIDGE_SECRET=your-shared-secret-here

# --- OPTIONAL: SUPER ADMIN HARDWARE BYPASS PIN ------------------------------
# SUPER_ADMIN_USB_KEY=your-usb-key-identifier

# --- OPTIONAL: INTERNAL API KEY FOR PACS INTAKE AGENT ------------------------
# INTERNAL_API_KEY=your-secure-internal-api-key-here
