# =============================================================================
# Care Diagnostics — Environmental Configuration Template
# =============================================================================
# Copy this file to ".env" in the same folder as your docker-compose.yml file.
# Replace all placeholder values with secure, strong credentials.

# --- NETWORK & PORTS ---------------------------------------------------------
# Host port nginx will listen on. Open http://localhost:<HOST_PORT> (or http://<nas-ip>:<HOST_PORT>)
HOST_PORT=8888

# --- RELEASE IDENTITY (set automatically by deploy-synology.sh) ---------------
# Written into .env on every normal Synology deploy so docker compose / Container
# Manager can interpolate build.args without manual edits. Do not hard-code.
#   GIT_COMMIT / GIT_BRANCH / GIT_TAG / BUILD_DATE  ← live Git + UTC timestamp
#   ERP_VERSION / BUILD_NUMBER / RELEASE_NAME      ← version.json via bump-build.cjs
# Alias CARE_GIT_SHA is also accepted by the Vite/API resolvers.
# GIT_COMMIT=
# GIT_BRANCH=
# GIT_TAG=
# BUILD_DATE=
# ERP_VERSION=
# BUILD_NUMBER=
# RELEASE_NAME=
# CARE_GIT_SHA=

# --- DATABASE SETTINGS -------------------------------------------------------
# Used both by the PostgreSQL container and the API service connection string
# ⚠️ CHANGE THESE credentials before deploying. Patient data is stored here!
DB_USER=erp
DB_PASSWORD=changeme
DB_NAME=diagnostic_erp

# --- API SERVICES CONFIGURATION ---------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# JWT/Session authentication secrets (Make these long, random strings)
JWT_SECRET=change-me-to-a-long-random-secret
SESSION_SECRET=change-me-to-another-long-random-secret

# Directory inside the container where uploaded documents/reports are saved
OBJECT_STORAGE_DIR=/app/data/object-storage

# --- OPTIONAL: GEMINI AI INTEGRATION (For automated report suggestions) -----
# AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_api_key_here
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- OPTIONAL: CLOUD AI PROVIDERS (OpenAI-compatible; trial / Test Lab) --------
# Server-side only. Never expose to the browser. Local Ollama remains default.
# Prefer ai_provider_settings encrypted keys for production; env is accepted for
# controlled clinic trials when DB rows are not yet configured.
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# QWEN_API_KEY=sk-your-dashscope-intl-key
# (alias) DASHSCOPE_API_KEY=sk-your-dashscope-intl-key
# Default intl endpoint, or your Model Studio workspace URL ending in /compatible-mode/v1
# (CARE does not append /compatible-mode/v1 again). Example Singapore MaaS:
# QWEN_BASE_URL=https://ws-cw7cjvg29sr59pb1.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Must also be listed under care-api environment in docker-compose.yml to reach the container.
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- OPTIONAL: PACS / ORTHANC INTEGRATION (For RIS-PACS/OHIF features) ------
# PACS provider: "orthanc" (recommended) or "conquest"
# PACS_PROVIDER=orthanc
#
# Care Diagnostics Orthanc (care-pacs container on Synology):
#   LAN (Synology NAS on clinic network): http://172.16.1.139:8042
#   (Neither of the above is a Docker bridge IP — Docker bridge addresses are
#   auto-assigned inside 172.17.x.x-172.31.x.x and are NEVER reachable by a
#   browser or Weasis. If care-api logs warn about a "Docker bridge IP", the
#   value below has accidentally been set to one of those internal addresses
#   instead of your real LAN/Tailscale/public URL.)
# ORTHANC_URL=http://172.16.1.139:8042
# ORTHANC_USERNAME=admin
# ORTHANC_PASSWORD=
#
# Viewer: "ohif" (web-based, works over DICOMweb) or "weasis" (local Windows app)
# PACS_VIEWER_TYPE=ohif
# Browser-facing OHIF (Synology HTTPS RP + Pi-hole). Used by Load Clinic Viewer Defaults.
# OHIF_PUBLIC_BASE_URL=https://ohif.caredeoghar.com
# OHIF_BROWSER_BASE_URL=https://ohif.caredeoghar.com
# Legacy container/LAN port (NOT used for embeddable ohif_base_url defaults):
# OHIF_URL=http://172.16.1.139:3010
# WADO_URL=http://172.16.1.139:8042/wado
#
# WEASIS_WADO_PUBLIC_URL (OPTIONAL): the WADO endpoint a doctor's local Weasis
# install connects to when launching a study from the ERP. Distinct from
# ORTHANC_INTERNAL_URL below (container-to-container only) — this one must be
# reachable from the doctor's own machine, so use LAN, Tailscale, or your
# public domain, never a Docker bridge IP:
#   LAN:       http://172.16.1.139:8042/wado
#   Tailscale: http://100.65.255.115:8042/wado
# WEASIS_WADO_PUBLIC_URL=http://172.16.1.139:8042/wado
#
# Allow API container to call LAN IPs (required for Orthanc on same LAN)
# ALLOW_PRIVATE_IPS=true
#
# Health-check probe overrides (OPTIONAL — dashboard diagnostics only, does
# NOT affect what URL opens in the doctor's browser). Docker containers often
# cannot reach the NAS's own external LAN IP ("hairpin NAT" limitation), which
# can make the Network Control Center show OHIF/Orthanc as red even though
# they work fine for real users. If that happens, set these to whatever
# address the api-server container CAN reach (e.g. an internal Docker service
# name, or the Docker bridge gateway IP):
# ORTHANC_INTERNAL_URL=http://care-orthanc:8042
# OHIF_INTERNAL_URL=http://172.16.1.139:3010
#
# Modality Worklist (MWL) — ERP sends patient/doctor names + accession to MRI/CT/USG.
# Shared directory with Orthanc worklists plugin (dump2dcm writes .wl files here).
# Billing always inserts radiology_scheduled_procedures; .wl files only when this is set.
# See docs/MWL_SETUP_SIMPLE.md for full setup.
ORTHANC_WORKLIST_DIR=/orthanc-worklists
ORTHANC_WORKLIST_HOST_DIR=/volume1/docker/care-pacs/orthanc/worklists
# Staging defaults to <ORTHANC_WORKLIST_DIR>/staging on the SAME bind mount
# (required for atomic rename). Only set this if staging is a sibling under the
# same parent mount — never a separate Docker volume.
# ORTHANC_WORKLIST_STAGING_DIR=/orthanc-worklists/staging
# mwl-guard quarantine (read-only in care-api). Do not copy these files back into worklists.
ORTHANC_WORKLIST_BAD_DIR=/worklists-bad
ORTHANC_WORKLIST_BAD_HOST_DIR=/volume1/docker/care-pacs/orthanc/worklists-bad

# --- OPTIONAL: FINGERPRINT SCANNER BRIDGE ------------------------------------
# FINGERPRINT_BRIDGE_SECRET=your-shared-secret-here

# --- OPTIONAL: DICOM PRINT BRIDGE ---------------------------------------------
# Lets the Reporting Workspace print USG/echo images directly to the clinic's
# glossy-photo printer (see drabinash/dicomtowindows on the NAS) instead of
# only via a physical DICOM modality. Both must be set for the "Print" button
# in the workspace to work — leave unset to hide/disable that feature.
# PRINT_BRIDGE_URL=http://192.168.1.150:8090
# PRINT_BRIDGE_SECRET=match-this-to-HTTP_BRIDGE_SECRET-on-the-print-bridge

# --- BOOTSTRAP ADMIN SAFETY ---------------------------------------------------
# On every startup, the API checks if the `users` table is empty and, if so,
# creates one initial super-admin account (default PIN 1234) so you can log
# in for the first time. Once ANY user exists, this is normally a no-op.
#
# BOOTSTRAP_ADMIN_FORCE=true changes that: it makes the API reset the
# bootstrap admin's PIN/role back to defaults on EVERY restart, even if
# users already exist. This is ONLY for emergency admin recovery (e.g. you
# forgot the PIN and have no other admin account) — never leave it on.
#
# ⚠️ PRODUCTION VALUE: BOOTSTRAP_ADMIN_FORCE=false (or leave this line
# commented out entirely — false is the default).
#
# Emergency recovery procedure:
#   1. Set BOOTSTRAP_ADMIN_FORCE=true in .env
#   2. Redeploy: docker compose up -d
#   3. Log in with the bootstrap email + default PIN (see below)
#   4. Immediately change the PIN through the UI
#   5. Set BOOTSTRAP_ADMIN_FORCE=false (or remove the line) and redeploy again
# BOOTSTRAP_ADMIN_FORCE=false
# BOOTSTRAP_ADMIN_EMAIL=abinashsingh@gmail.com
# BOOTSTRAP_ADMIN_NAME=Dr Abinash Kumar
# BOOTSTRAP_ADMIN_PIN=1234
# BOOTSTRAP_ADMIN_ROLE=super_admin

# --- OPTIONAL: SUPER ADMIN USB PEN-DRIVE GATE --------------------------------
# Contents of superadmin.key / superadmin.pin on the physical pen drive.
# Both must also be listed under care-api.environment in docker-compose.yml
# (already wired) — putting them only in .env is not enough.
# SUPER_ADMIN_USB_KEY=your-64-char-hex-from-superadmin.key
# SUPER_ADMIN_USB_PIN=2321

# --- OPTIONAL: INTERNAL API KEY FOR PACS INTAKE AGENT ------------------------
# Bearer token for /api/internal/* (DICOM intake, HL7, backup export).
# MUST be at least 16 random characters — weak values like "1234" are blocked.
# MUST match care_erp_sync.py ERP_INTERNAL_API_KEY on the Orthanc/NAS host.
# Generate: openssl rand -base64 32   or: bash scripts/rotate-internal-api-key.sh
# INTERNAL_API_KEY=your-secure-internal-api-key-here

# --- OPTIONAL: CARE REPORTING STUDIO BRIDGE ----------------------------------
# Static API key for the Reporting Studio (Settings → Integrations). Sent as
# the x-api-key header on /api/internal/reporting-studio/*. Unset → 503.
# Generate: openssl rand -hex 24
# REPORTING_STUDIO_API_KEY=

# --- OPTIONAL: LOCAL OLLAMA AI INTEGRATION ------------------------------------
# Canonical Local AI (chat/vision): ONE endpoint + ONE model until architecture stabilizes.
# Runtime resolution: resolveLocalAiRuntime() — clinic_settings overlays these env defaults.
# Settings UI: Radiology Settings → AI → Local AI (NOT multi-provider Ollama row).
#
# OLLAMA_PRIMARY_URL=http://172.16.1.140:11434
# OLLAMA_BASE_URL=http://172.16.1.140:11434
#
# --- OCR + AI PIPELINE (Windows AI/OCR worker) --------------------------------
# PaddleOCR worker (default port 8090) — install via ocr-worker/install-windows.ps1
# OCR_ENGINE=paddle
# OCR_PROFILE=fast
# OCR_DEVICE=cpu
# OCR_LOW_CONFIDENCE_THRESHOLD=0.80
# OCR_RETRY_ACCURATE=true
# OCR_TESSERACT_FALLBACK=true
# OCR_VISION_FALLBACK=false
# OCR_WORKER_URL=http://172.16.1.140:8090
# OCR_WORKER_TOKEN=   # REQUIRED — same value as Windows ocr-worker/.env
# OCR_WORKER_CONCURRENCY=1
#
# AI_MODE=AUTO
# AI_MODEL_FAST=qwen3-vl:8b
# AI_MODEL_STANDARD=qwen3-vl:8b
# AI_MODEL_LARGE=qwen3-vl:8b
# AI_MODEL_VISION=qwen3-vl:8b
# OLLAMA_NUM_CTX=16384
# OLLAMA_THINK=0
# AI_TIMEOUT_FAST_SECONDS=120
# AI_TIMEOUT_LARGE_SECONDS=300
# AI_CONCURRENCY=1
# AI_TEMPERATURE_EXTRACTION=0
# AI_TEMPERATURE_DRAFT=0.1
#
# Embeddings (separate from chat/vision): RAG_EMBED_MODEL=nomic-embed-text
#
# Canonical Local AI runtime: Settings → AI → Local AI overlays env defaults
# (Ollama URL + local chat/vision model). Env alone is not a second config store.
#
# Rollback to legacy vision/Tesseract path without code changes:
#   OCR_ENGINE=tesseract
# or OCR_ENGINE=vision
#
# Approved routine model: gemma3:4b (pull on Windows: ollama pull gemma3:4b)
# Deep/Large only: gemma3:12b (warn: may be slow on RTX 3050 8GB)
# Legacy approved: qwen3:14b, gpt-oss:20b (stored provider default still wins)
# OLLAMA_DEFAULT_MODEL=gemma3:4b
#
# NOTE: Ollama port 11434 and OCR worker 8090 must NOT be exposed publicly.
# Only Open WebUI (port 3000) is exposed. Ollama/OCR stay LAN-only.
# Acceptance: node scripts/production-acceptance-ocr-ai.mjs
#
# Open WebUI Ollama URL (set in Synology Container Manager environment variables):
# OLLAMA_BASE_URL=http://192.168.1.250:11434

# CORS — comma-separated list of allowed origins (leave blank for same-origin only)
# Example: https://caredeoghar.com,https://app.caredeoghar.com
ALLOWED_ORIGINS=

# ─── HOPE Hospital integration (172.16.1.139:7080) ───────────────────────────
# Synology defaults (must match Hope deploy/synology/hope.env).
# care-api registers the HOPE partner + enables ff_hope_care_referrals on
# container start when HOPE_PARTNER_KEY is set — no manual bootstrap.
# Full template: deploy/synology/care.env
#
# THE TWO KEYS BELOW ARE NEVER COMMITTED. They were, while this repository was
# public, which makes those values disclosed: rotate before enabling the
# integration and follow docs/hope-care-integration/06_CREDENTIAL_ROTATION.md.
# Generate one per side: `openssl rand -hex 32`.
INTEGRATION_HOPE_CALLBACK_URL=http://172.16.1.139:7080/api/integration/care-callback
# HMAC key for CARE→HOPE callbacks. Must equal HOPE's CARE_CALLBACK_SECRET.
INTEGRATION_HOPE_SIGNING_SECRET=
# Set to 1 only once both keys above hold real values: an armed host with no
# partner key fails the deploy gate instead of registering a published credential.
# (deploy/synology/care.env keeps it at 1 — that is the clinic's NAS template, which
# does run the integration; this file is the generic one.)
HOPE_CARE_INTEGRATION_FORCE=
# Bearer key HOPE sends to CARE. Must equal HOPE's CARE_PARTNER_KEY.
HOPE_PARTNER_KEY=

# ─── CENTRAL NETWORK CONFIGURATION (Phase B — never hardcode) ────────────────
# All network host/port fallbacks now live in exactly two files:
#   Backend:  artifacts/api-server/src/lib/networkDefaults.ts
#   Frontend: artifacts/diagnostic-erp/src/lib/networkProfiles.ts
# Defaults match the current clinic network, so NOTHING breaks if these are
# left unset. Set them only if the clinic network ever changes.
# Admin-settings (pacs_settings table) still override everything at runtime.

# Backend (API server)
# NETWORK_LAN_HOST=172.16.1.139
# NETWORK_TAILSCALE_HOST=100.65.255.115
# NETWORK_PUBLIC_DOMAIN=caredeoghar.com
# ORTHANC_HTTP_PORT=8042
# ORTHANC_DICOM_PORT=4242
# OHIF_HTTP_PORT=3010
# ERP_HTTP_PORT=8888
# CONQUEST_DICOM_PORT=5678

# Frontend (baked at Vite build time; admin settings override at runtime)
# VITE_NETWORK_LAN_HOST=172.16.1.139
# VITE_NETWORK_LAN_HOST_ALT=192.168.1.137
# VITE_NETWORK_TAILSCALE_HOST=100.65.255.115
# VITE_NETWORK_PUBLIC_DOMAIN=caredeoghar.com
# VITE_ORTHANC_HTTP_PORT=8042
# VITE_OHIF_HTTP_PORT=3010
# VITE_OHIF_PUBLIC_BASE_URL=https://ohif.caredeoghar.com
# VITE_OHIF_BROWSER_BASE_URL=https://ohif.caredeoghar.com
# VITE_ERP_HTTP_PORT=8888

# ─── DOCUMENT SCAN BRIDGE (per-workstation, optional override) ───────────────
# Local scanner-bridge service address for Form F ID scanning. Runs on each
# billing PC (scan-bridge/), not on the server. Default matches the bridge's
# own default port; only set this if a workstation runs the bridge on a
# different port.
# VITE_SCAN_BRIDGE_URL=http://127.0.0.1:8766

# ─── WHATSAPP CLOUD API (official Meta WhatsApp Business Platform) ───────────
# The ONLY supported production provider. Configure it primarily through the
# ERP: Admin -> Integrations -> WhatsApp (/admin/integrations/whatsapp) —
# credentials are stored encrypted in the database, not here. The variables
# below are a legacy env-var fallback only, read if the DB settings row has
# no value for that field yet.
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
#
# Dedicated bearer token for n8n's WhatsApp automation triggers
# (/api/internal/automations/whatsapp/*) — separate from CRON_SECRET so a
# leaked WhatsApp automation token cannot also trigger backups. Generate with
# `openssl rand -base64 32` (32+ random characters; weak/placeholder values
# are rejected at request time, not just at startup).
# WHATSAPP_AUTOMATION_SECRET=

# ─── n8n (workflow automation — schedules only, never touches CARE's DB) ─────
# N8N_URL=http://172.16.1.139:5678

# ─── DS225+ Emergency Billing (CARE side) ────────────────────────────────────
# Interval for the scheduled master-data push (hours). Only the process with
# ENABLE_SCHEDULERS=1 should run it. Duplicate API instances are also guarded
# by a Postgres advisory lock. Manual Push Now is always available in
# Settings → Billing → Emergency Billing.
# EMERGENCY_MASTER_SYNC_INTERVAL_HOURS=6
# Optional fallbacks if Settings has not stored the NAS URL/token yet:
# EMERGENCY_NAS_URL=http://192.168.50.10
# EMERGENCY_NAS_FETCH_TOKEN=

# ─── LOCAL DEVELOPMENT ISOLATION (never set on the Synology) ─────────────────
# For a development checkout running against a database RESTORED FROM THE
# PRODUCTION SNAPSHOT. Started with `pnpm dev:isolated`. With CARE_DEV_ISOLATED
# absent, every one of these is inert and the production boot path is unchanged.
#
# ON = no schedulers, no DICOM/Orthanc polling, no study warming, no
# reconciliation, no job consumers, no startup schema patches; outbound
# production integrations (partner callbacks, WhatsApp, SMTP, payments, DICOM
# associations, cloud AI) are refused; the API binds 127.0.0.1:8181 and Vite
# 127.0.0.1:5173 with /api and /uploads proxied there.
#
# It REFUSES TO START if DATABASE_URL is not the approved development database —
# a stale restored .env cannot make an "isolated" instance reach the clinic.
# CARE_DEV_ISOLATED=1
# The one database isolated mode will attach to (override only for another box,
# and it must stay on loopback).
# CARE_DEV_DATABASE_URL=postgresql://erp@127.0.0.1:5411/care_dev
# Extra local development services allowed out. Loopback is always permitted, so
# a local Orthanc/Ollama/MailHog needs nothing here. Private/LAN is NOT treated
# as local: 172.16.1.139 is the clinic's production NAS.
# CARE_DEV_EGRESS_ALLOW=192.168.1.50, orthanc-dev.local:8042
# CARE_DEV_API_PORT=8181
# CARE_DEV_ERP_PORT=5173
