# =============================================================================
# Care Diagnostics — Environmental Configuration Template
# =============================================================================
# Copy this file to ".env" in the same folder as your docker-compose.yml file.
# Replace all placeholder values with secure, strong credentials.

# --- NETWORK & PORTS ---------------------------------------------------------
# Host port nginx will listen on. Open http://localhost:<HOST_PORT> (or http://<nas-ip>:<HOST_PORT>)
HOST_PORT=8888

# --- DATABASE SETTINGS -------------------------------------------------------
# Used both by the PostgreSQL container and the API service connection string
# ⚠️ CHANGE THESE credentials before deploying. Patient data is stored here!
DB_USER=erp
DB_PASSWORD=changeme
DB_NAME=diagnostic_erp

# --- API SERVICES CONFIGURATION ---------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# JWT/Session authentication secrets (Make these long, random strings)
JWT_SECRET=change-me-to-a-long-random-secret
SESSION_SECRET=change-me-to-another-long-random-secret

# Directory inside the container where uploaded documents/reports are saved
OBJECT_STORAGE_DIR=/app/data/object-storage

# --- OPTIONAL: GEMINI AI INTEGRATION (For automated report suggestions) -----
# AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_api_key_here
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- OPTIONAL: PACS / ORTHANC INTEGRATION (For RIS-PACS/OHIF features) ------
# PACS provider: "orthanc" (recommended) or "conquest"
# PACS_PROVIDER=orthanc
#
# Care Diagnostics Orthanc (care-pacs container on Synology):
#   LAN (real clinic network, browser/Weasis reachable): http://192.168.1.137:8042
#   Alt LAN address seen on this NAS's subnet:           http://172.16.1.139:8042
#   (Neither of the above is a Docker bridge IP — Docker bridge addresses are
#   auto-assigned inside 172.17.x.x-172.31.x.x and are NEVER reachable by a
#   browser or Weasis. If care-api logs warn about a "Docker bridge IP", the
#   value below has accidentally been set to one of those internal addresses
#   instead of your real LAN/Tailscale/public URL.)
# ORTHANC_URL=http://192.168.1.137:8042
# ORTHANC_USERNAME=admin
# ORTHANC_PASSWORD=
#
# Viewer: "ohif" (web-based, works over DICOMweb) or "weasis" (local Windows app)
# PACS_VIEWER_TYPE=ohif
# OHIF_URL=http://192.168.1.137:3010
# WADO_URL=http://192.168.1.137:8042/wado
#
# WEASIS_WADO_PUBLIC_URL (OPTIONAL): the WADO endpoint a doctor's local Weasis
# install connects to when launching a study from the ERP. Distinct from
# ORTHANC_INTERNAL_URL below (container-to-container only) — this one must be
# reachable from the doctor's own machine, so use LAN, Tailscale, or your
# public domain, never a Docker bridge IP:
#   LAN:       http://192.168.1.137:8042/wado
#   Tailscale: http://100.65.255.115:8042/wado
# WEASIS_WADO_PUBLIC_URL=http://192.168.1.137:8042/wado
#
# Allow API container to call LAN IPs (required for Orthanc on same LAN)
# ALLOW_PRIVATE_IPS=true
#
# Health-check probe overrides (OPTIONAL — dashboard diagnostics only, does
# NOT affect what URL opens in the doctor's browser). Docker containers often
# cannot reach the NAS's own external LAN IP ("hairpin NAT" limitation), which
# can make the Network Control Center show OHIF/Orthanc as red even though
# they work fine for real users. If that happens, set these to whatever
# address the api-server container CAN reach (e.g. an internal Docker service
# name, or the Docker bridge gateway IP):
# ORTHANC_INTERNAL_URL=http://care-orthanc:8042
# OHIF_INTERNAL_URL=http://192.168.1.137:3010

# --- OPTIONAL: FINGERPRINT SCANNER BRIDGE ------------------------------------
# FINGERPRINT_BRIDGE_SECRET=your-shared-secret-here

# --- BOOTSTRAP ADMIN SAFETY ---------------------------------------------------
# On every startup, the API checks if the `users` table is empty and, if so,
# creates one initial super-admin account (default PIN 1234) so you can log
# in for the first time. Once ANY user exists, this is normally a no-op.
#
# BOOTSTRAP_ADMIN_FORCE=true changes that: it makes the API reset the
# bootstrap admin's PIN/role back to defaults on EVERY restart, even if
# users already exist. This is ONLY for emergency admin recovery (e.g. you
# forgot the PIN and have no other admin account) — never leave it on.
#
# ⚠️ PRODUCTION VALUE: BOOTSTRAP_ADMIN_FORCE=false (or leave this line
# commented out entirely — false is the default).
#
# Emergency recovery procedure:
#   1. Set BOOTSTRAP_ADMIN_FORCE=true in .env
#   2. Redeploy: docker compose up -d
#   3. Log in with the bootstrap email + default PIN (see below)
#   4. Immediately change the PIN through the UI
#   5. Set BOOTSTRAP_ADMIN_FORCE=false (or remove the line) and redeploy again
# BOOTSTRAP_ADMIN_FORCE=false
# BOOTSTRAP_ADMIN_EMAIL=abinashsingh@gmail.com
# BOOTSTRAP_ADMIN_NAME=Dr Abinash Kumar
# BOOTSTRAP_ADMIN_PIN=1234
# BOOTSTRAP_ADMIN_ROLE=super_admin

# --- OPTIONAL: SUPER ADMIN HARDWARE BYPASS PIN ------------------------------
# SUPER_ADMIN_USB_KEY=your-usb-key-identifier

# --- OPTIONAL: INTERNAL API KEY FOR PACS INTAKE AGENT ------------------------
# INTERNAL_API_KEY=your-secure-internal-api-key-here

# --- OPTIONAL: LOCAL OLLAMA AI INTEGRATION ------------------------------------
# Ollama runs on Windows PC on the same LAN as Synology NAS.
# Settings are also configurable in ERP: Settings ? AI ? Local AI.
#
# Windows PC primary LAN IP (configure in ERP admin, not here directly)
# OLLAMA_PRIMARY_URL=http://192.168.1.250:11434
#
# Windows PC secondary LAN IP / fallback NIC
# OLLAMA_FALLBACK_URL=http://172.16.1.140:11434
#
# Default model (medgemma:27b = best medical, gemma4:12b = faster, qwen3:14b = formatting)
# OLLAMA_DEFAULT_MODEL=medgemma:27b
#
# NOTE: Ollama port 11434 must NOT be exposed publicly via Cloudflare Tunnel.
# Only Open WebUI (port 3000) is exposed. Ollama stays LAN-only.
#
# Open WebUI Ollama URL (set in Synology Container Manager environment variables):
# OLLAMA_BASE_URL=http://192.168.1.250:11434

# CORS — comma-separated list of allowed origins (leave blank for same-origin only)
# Example: https://caredeoghar.com,https://app.caredeoghar.com
ALLOWED_ORIGINS=

# ─── CENTRAL NETWORK CONFIGURATION (Phase B — never hardcode) ────────────────
# All network host/port fallbacks now live in exactly two files:
#   Backend:  artifacts/api-server/src/lib/networkDefaults.ts
#   Frontend: artifacts/diagnostic-erp/src/lib/networkProfiles.ts
# Defaults match the current clinic network, so NOTHING breaks if these are
# left unset. Set them only if the clinic network ever changes.
# Admin-settings (pacs_settings table) still override everything at runtime.

# Backend (API server)
# NETWORK_LAN_HOST=192.168.1.137
# NETWORK_TAILSCALE_HOST=100.65.255.115
# NETWORK_PUBLIC_DOMAIN=caredeoghar.com
# ORTHANC_HTTP_PORT=8042
# ORTHANC_DICOM_PORT=4242
# OHIF_HTTP_PORT=3010
# ERP_HTTP_PORT=8888
# CONQUEST_DICOM_PORT=5678

# Frontend (baked at Vite build time; admin settings override at runtime)
# VITE_NETWORK_LAN_HOST=192.168.1.137
# VITE_NETWORK_TAILSCALE_HOST=100.65.255.115
# VITE_NETWORK_PUBLIC_DOMAIN=caredeoghar.com
# VITE_ORTHANC_HTTP_PORT=8042
# VITE_OHIF_HTTP_PORT=3010
# VITE_ERP_HTTP_PORT=8888
