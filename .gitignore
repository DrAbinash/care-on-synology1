.cache/
.local/

# Local environment files — NEVER COMMIT THESE
.env
.env.local
.env.*.local
env
env_my_temp.txt
env_my_temp*
*.env.backup

# Per-box operator evidence read by scripts/ops-preflight.mjs. Kept untracked on
# purpose: deploy-synology.sh runs `git reset --hard origin/main`, which would
# erase a tracked record of what was actually proven on this machine.
ops-evidence.json
*---delete*
superadmin.key

# Runtime upload storage — REAL PATIENT DATA. The API writes these at
# <cwd-ancestor>/data/uploads, which resolves differently per launch
# directory, so the pattern is depth-independent on purpose: it covers
# data/uploads/, artifacts/data/uploads/ and artifacts/api-server/data/uploads/.
# These hold radiology key images (DICOM renders of named studies) and expense
# bill/receipt photographs. Nothing under any data/uploads path is tracked, so
# this excludes runtime data only and no application file. The leading **/ is
# required: a pattern containing a middle separator is anchored to this file's
# directory, so "data/uploads/" alone would miss artifacts/data/uploads/.
**/data/uploads/

# Large binary / database dumps — cause mmap errors on Windows git
*.dump
*.sql.gz
current_*.sql
current_*.dump
*_backup.sql
*_backup.dump

# Scratch / temp files
scratch/*.js
query_db*.js
query_db*.cjs
run-test*.js
test_icici_endpoints.js
e2e-*.spec.ts
bill_preview.html
diff.txt
counts*.sql
counts_raw*.sql
table_list.txt
*.spec.ts.bak

# Screenshots and exports (large, not needed in git)
screenshots/
exports/
test-results/

# MRI report archive — owner keeps copies on Windows PC; not used by CARE/Synology/Docker
mri-reports/

# Attached assets (uploaded text files, large)
attached_assets/

# Synology NAS system folders (thumbnail cache, metadata)
@eaDir/
@SynoResource/
@tmp/
.DS_Store
Thumbs.db

# Local test Postgres data directory (created by the DB test harness)
.pgtest/
.pnpm-store/
.schema-verify-results.json

# Python
__pycache__/
*.py[cod]
.venv/
ocr-worker/.venv/
ocr-worker/.env

legacy-reference/

# Written by scripts/build-identity.mjs during a build, and by the identity tests.
# It names a commit, so a stray copy in a checkout must never be committable.
build-info.json
