{
  "expo": {
    "name": "Care Diagnostics Booking",
    "slug": "diagno-booking-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "diagno-booking-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.caredeoghar.booking",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan or attach photos when booking a test.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos when booking a test.",
        "NSLocationWhenInUseUsageDescription": "Used to show directions to the clinic."
      }
    },
    "android": {
      "package": "com.caredeoghar.booking",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0ea5e9"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach photos when booking a test.",
          "cameraPermission": "Used to scan or attach photos when booking a test."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
