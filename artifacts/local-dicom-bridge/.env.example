# Care Diagnostics Local DICOM Bridge — .env template
# Copy to .env and fill in your values.

# Where the ERP API lives (your deployed app URL)
ERP_BASE_URL=https://your-app.replit.app

# INTERNAL_API_KEY must match the server secret. Get it from your ERP admin.
INTERNAL_API_KEY=your-internal-api-key-here

# Agent identity (shows in ERP → Radiology → Agent Status)
AGENT_ID=clinic-pc-01
AGENT_AE_TITLE=DIAGNO_AGENT

# Local DICOM SCP (where pulled studies arrive — usually your Conquest PACS)
# If every node in ERP has its own conquestAeTitle/conquestHost/conquestPort,
# these are only fallbacks for nodes missing per-node settings.
CONQUEST_HOST=127.0.0.1
CONQUEST_PORT=5678
CONQUEST_AE_TITLE=CONQUEST1

# Polling interval in milliseconds (default 10 minutes = 600000)
POLL_INTERVAL_MS=600000

# DIMSE timeout per operation in ms (default 60 seconds)
DIMSE_TIMEOUT_MS=60000

# Max parallel jobs (default 3)
MAX_CONCURRENT_JOBS=3

# Config auto-refresh from ERP every N ms (default 5 minutes)
CONFIG_REFRESH_MS=300000

# Set to 0 to disable remote config fetch (use only local env values)
ERP_CONFIG_ENABLED=1