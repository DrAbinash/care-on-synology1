# Public URL where the api-server is reachable from the visitor's browser.
# Leave empty when the site is served from the same origin as the API
# (e.g. behind a reverse proxy that maps /api/* to the api-server).
#
# Examples:
#   VITE_API_BASE_URL=https://api.my-clinic.com
#   VITE_API_BASE_URL=https://my-clinic.com   (proxy on same domain)
VITE_API_BASE_URL=

# Public URL where uploaded files (/uploads/*) are served from.
# Defaults to VITE_API_BASE_URL when empty. Set this only if you serve
# uploads from a different host (CDN, NAS share, S3-compatible, etc.).
VITE_ASSET_BASE_URL=

# Optional. URL prefix the SPA is served from. Use "/" for root hosting,
# or "/clinic/" if mounted under a sub-path. Read by vite.config.ts.
BASE_PATH=/
